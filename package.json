{
  "name": "native-typescript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @native-typescript/bindgen-gir build:tool",
    "build:watch": "tsc -b --watch --preserveWatchOutput",
    "clean": "tsc -b --clean",
    "dev": "node --watch packages/cli/src/main.ts",
    "native-typescript": "node packages/cli/src/main.ts",
    "test": "pnpm build && node --test tests/*.test.ts",
    "scriptc:install": "pnpm --dir third_party/scriptc install --frozen-lockfile",
    "scriptc:build": "pnpm --dir third_party/scriptc build",
    "scriptc:test:manifest": "pnpm --dir=third_party/scriptc exec vitest run packages/compiler/test/native-manifest.test.ts",
    "scriptc:test:export": "node scripts/test-scriptc-export.mjs",
    "scriptc:test:native-ir": "node scripts/test-scriptc-native-ir.mjs",
    "scriptc:test:sanitized": "node scripts/test-scriptc-sanitized.mjs",
    "scriptc:test:owner-gateway": "pnpm --dir=third_party/scriptc exec vitest run tests/harness/owner-gateway.test.ts",
    "scriptc:test:callback-token": "pnpm --dir=third_party/scriptc exec vitest run tests/harness/callback-token.test.ts",
    "scriptc:test:callback-table": "pnpm --dir=third_party/scriptc exec vitest run tests/harness/callback-table.test.ts",
    "scriptc:test:callback-handle": "pnpm --dir=third_party/scriptc exec vitest run tests/harness/callback-handle.test.ts",
    "scriptc:test": "pnpm --dir third_party/scriptc test:sandbox"
  },
  "devDependencies": {
    "@native-typescript/bindgen-c": "workspace:*",
    "@native-typescript/bindgen-gir": "workspace:*",
    "@native-typescript/bindgen-jvm": "workspace:*",
    "@native-typescript/cli": "workspace:*",
    "@native-typescript/core": "workspace:*",
    "@native-typescript/scabi": "workspace:*",
    "@native-typescript/scriptc": "workspace:*",
    "@native-typescript/target-api": "workspace:*",
    "@native-typescript/target-gtk": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
