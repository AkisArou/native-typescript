{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://native-typescript.dev/schema/scabi/v11",
  "title": "Native TypeScript SCABI v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "package",
    "target",
    "sdk",
    "generator",
    "declarations",
    "types",
    "bindings",
    "linkInputs",
    "adapterInputs",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "native-typescript.scabi"
    },
    "schemaVersion": {
      "const": 11
    },
    "package": {
      "$ref": "#/$defs/packageIdentity"
    },
    "target": {
      "$ref": "#/$defs/targetIdentity"
    },
    "sdk": {
      "$ref": "#/$defs/sdkIdentity"
    },
    "generator": {
      "$ref": "#/$defs/generatorIdentity"
    },
    "declarations": {
      "$ref": "#/$defs/declarationContract"
    },
    "imports": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/typeImport"
      }
    },
    "types": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nativeType"
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nativeBinding"
      }
    },
    "linkInputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkInput"
      }
    },
    "adapterInputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adapterInput"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "memberName": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "namespace",
        "instance"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "namespace": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instance": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "targetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triple",
        "architecture",
        "pointerWidth",
        "endianness",
        "objectFormat",
        "minimumPlatformVersion",
        "abi",
        "features"
      ],
      "properties": {
        "triple": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pointerWidth": {
          "enum": [
            32,
            64
          ]
        },
        "endianness": {
          "enum": [
            "little",
            "big"
          ]
        },
        "objectFormat": {
          "enum": [
            "elf",
            "macho",
            "coff",
            "wasm"
          ]
        },
        "minimumPlatformVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "abi": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "features": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "sdkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "name",
        "version",
        "metadataDigest",
        "toolchain",
        "toolchainVersion",
        "toolchainAbi",
        "deploymentTarget",
        "modules"
      ],
      "properties": {
        "vendor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "metadataDigest": {
          "$ref": "#/$defs/digest"
        },
        "toolchain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "toolchainVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "toolchainAbi": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "deploymentTarget": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "modules": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "generatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision",
        "arguments",
        "inputDigests"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "arguments": {
          "$ref": "#/$defs/stringArray"
        },
        "inputDigests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        }
      }
    },
    "voidType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "void"
        }
      }
    },
    "integerType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "signed",
        "bits"
      ],
      "properties": {
        "kind": {
          "const": "integer"
        },
        "signed": {
          "type": "boolean"
        },
        "bits": {
          "enum": [
            8,
            16,
            32,
            64,
            "pointer"
          ]
        }
      }
    },
    "floatType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bits"
      ],
      "properties": {
        "kind": {
          "const": "float"
        },
        "bits": {
          "enum": [
            32,
            64
          ]
        }
      }
    },
    "booleanType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "storage",
        "falseValue",
        "trueValue"
      ],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "storage": {
          "$ref": "#/$defs/id"
        },
        "falseValue": {
          "type": "string"
        },
        "trueValue": {
          "type": "string"
        }
      }
    },
    "enumType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "underlying",
        "members"
      ],
      "properties": {
        "kind": {
          "const": "enum"
        },
        "underlying": {
          "$ref": "#/$defs/id"
        },
        "members": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/memberName"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "flagsType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "underlying",
        "members"
      ],
      "properties": {
        "kind": {
          "const": "flags"
        },
        "underlying": {
          "$ref": "#/$defs/id"
        },
        "members": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/memberName"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "pointerType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pointee",
        "mutability",
        "nullable",
        "addressSpace"
      ],
      "properties": {
        "kind": {
          "const": "pointer"
        },
        "pointee": {
          "$ref": "#/$defs/id"
        },
        "mutability": {
          "enum": [
            "const",
            "mutable"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "addressSpace": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "arrayType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "element",
        "length"
      ],
      "properties": {
        "kind": {
          "const": "array"
        },
        "element": {
          "$ref": "#/$defs/id"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sliceType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "element",
        "pointerType",
        "lengthType",
        "mutability"
      ],
      "properties": {
        "kind": {
          "const": "slice"
        },
        "element": {
          "$ref": "#/$defs/id"
        },
        "pointerType": {
          "$ref": "#/$defs/id"
        },
        "lengthType": {
          "$ref": "#/$defs/id"
        },
        "mutability": {
          "enum": [
            "const",
            "mutable"
          ]
        }
      }
    },
    "bitField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bitOffset",
        "bitWidth"
      ],
      "properties": {
        "bitOffset": {
          "type": "integer",
          "minimum": 0
        },
        "bitWidth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativeField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "offset"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/memberName"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "bitField": {
          "$ref": "#/$defs/bitField"
        },
        "conversion": {
          "$ref": "#/$defs/conversion"
        }
      }
    },
    "conversion": {
      "const": "number"
    },
    "nativePhysicalAbiType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "void"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bits"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "bits": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "format"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "format": {
              "enum": [
                "half",
                "bfloat",
                "float",
                "double",
                "fp128",
                "x86_fp80"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "addressSpace"
          ],
          "properties": {
            "kind": {
              "const": "pointer"
            },
            "addressSpace": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "count",
            "element"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "element": {
              "$ref": "#/$defs/nativePhysicalAbiType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "count",
            "scalable",
            "element"
          ],
          "properties": {
            "kind": {
              "const": "vector"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "scalable": {
              "type": "boolean"
            },
            "element": {
              "$ref": "#/$defs/nativePhysicalAbiType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "packed",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "struct"
            },
            "packed": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nativePhysicalAbiType"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "aggregate"
            }
          }
        }
      ]
    },
    "nativePhysicalAbiValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "alignment",
        "stackAlignment",
        "extension",
        "inRegister",
        "byValue",
        "structureReturn"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nativePhysicalAbiType"
        },
        "alignment": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stackAlignment": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "extension": {
          "enum": [
            "sign",
            "zero",
            null
          ]
        },
        "inRegister": {
          "type": "boolean"
        },
        "byValue": {
          "type": "boolean"
        },
        "structureReturn": {
          "type": "boolean"
        }
      }
    },
    "aggregateAbiPassing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "parameters"
      ],
      "properties": {
        "result": {
          "$ref": "#/$defs/nativePhysicalAbiValue"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativePhysicalAbiValue"
          },
          "minItems": 1
        }
      }
    },
    "structType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fields",
        "size",
        "alignment",
        "packing",
        "triviallyCopyable",
        "destruction"
      ],
      "properties": {
        "kind": {
          "const": "struct"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeField"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "alignment": {
          "type": "integer",
          "minimum": 1
        },
        "packing": {
          "oneOf": [
            {
              "const": "default"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "triviallyCopyable": {
          "type": "boolean"
        },
        "destruction": {
          "enum": [
            "trivial",
            "binding"
          ]
        },
        "abiPassing": {
          "$ref": "#/$defs/aggregateAbiPassing"
        }
      }
    },
    "unionType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fields",
        "size",
        "alignment",
        "packing",
        "triviallyCopyable",
        "destruction"
      ],
      "properties": {
        "kind": {
          "const": "union"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeField"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "alignment": {
          "type": "integer",
          "minimum": 1
        },
        "packing": {
          "oneOf": [
            {
              "const": "default"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "triviallyCopyable": {
          "type": "boolean"
        },
        "destruction": {
          "enum": [
            "trivial",
            "binding"
          ]
        },
        "abiPassing": {
          "$ref": "#/$defs/aggregateAbiPassing"
        },
        "discriminator": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "opaqueValueType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nativeName",
        "size",
        "alignment",
        "packing",
        "triviallyCopyable",
        "destruction"
      ],
      "properties": {
        "kind": {
          "const": "opaque-value"
        },
        "nativeName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "alignment": {
          "type": "integer",
          "minimum": 1
        },
        "packing": {
          "oneOf": [
            {
              "const": "default"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "triviallyCopyable": {
          "type": "boolean"
        },
        "destruction": {
          "enum": [
            "trivial",
            "binding"
          ]
        },
        "abiPassing": {
          "$ref": "#/$defs/aggregateAbiPassing"
        }
      }
    },
    "handleType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nativeName",
        "threadSafety",
        "identity",
        "upcasts"
      ],
      "properties": {
        "kind": {
          "const": "handle"
        },
        "nativeName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "threadSafety": {
          "enum": [
            "confined",
            "sendable",
            "shared"
          ]
        },
        "identity": {
          "enum": [
            "none",
            "pointer",
            "binding",
            "platform"
          ]
        },
        "upcasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identityHandleUpcast"
          }
        },
        "destructor": {
          "$ref": "#/$defs/id"
        },
        "peerSlot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": { "$ref": "#/$defs/id" },
            "write": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "identityHandleUpcast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "identity"
        },
        "target": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "callbackContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement"
      ],
      "properties": {
        "placement": {
          "enum": [
            "none",
            "first",
            "last"
          ]
        },
        "type": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "callbackType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "signature",
        "context"
      ],
      "properties": {
        "kind": {
          "const": "callback"
        },
        "signature": {
          "$ref": "#/$defs/functionSignature"
        },
        "context": {
          "$ref": "#/$defs/callbackContext"
        }
      }
    },
    "nativeType": {
      "oneOf": [
        {
          "$ref": "#/$defs/voidType"
        },
        {
          "$ref": "#/$defs/integerType"
        },
        {
          "$ref": "#/$defs/floatType"
        },
        {
          "$ref": "#/$defs/booleanType"
        },
        {
          "$ref": "#/$defs/enumType"
        },
        {
          "$ref": "#/$defs/flagsType"
        },
        {
          "$ref": "#/$defs/pointerType"
        },
        {
          "$ref": "#/$defs/arrayType"
        },
        {
          "$ref": "#/$defs/sliceType"
        },
        {
          "$ref": "#/$defs/structType"
        },
        {
          "$ref": "#/$defs/unionType"
        },
        {
          "$ref": "#/$defs/opaqueValueType"
        },
        {
          "$ref": "#/$defs/handleType"
        },
        {
          "$ref": "#/$defs/callbackType"
        }
      ]
    },
    "ownership": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope"
          ],
          "properties": {
            "kind": {
              "const": "borrowed"
            },
            "scope": {
              "enum": [
                "call",
                "callback",
                "receiver",
                "registration",
                "returned-owner"
              ]
            },
            "anchor": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transfer"
          ],
          "properties": {
            "kind": {
              "const": "owned"
            },
            "transfer": {
              "const": "to-runtime"
            },
            "destructor": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transfer"
          ],
          "properties": {
