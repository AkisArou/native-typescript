# Copyright 2026
# Native TypeScript direct-Blink bridge. This file is overlaid into
# //third_party/blink/renderer/native_typescript by apply-chromium.ts.

# Portable C runtime state used by generated/native Web API calls. Keeping this
# separate prevents Blink's C++ PCH/configuration from becoming part of the C
# contract we eventually expect ScriptC-generated output to link against.
source_set("nts_web_runtime") {
  sources = [
    "runtime/nts_handle_table.c",
    "runtime/nts_handle_table.h",
    "runtime/nts_web_exception.c",
  ]

  include_dirs = [ "." ]

  # This target is a stable C ABI consumed by ScriptC-generated C. Chromium's
  # C++ raw_ptr replacement cannot appear in that layout contract, and the C
  # table implementation cannot use Chromium's C++ span vocabulary. Keep the
  # normal warning set while excluding those two migration plugins.
  configs -= [
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]
}

source_set("nts_blink_bridge") {
  sources = [
    "generated/nts_webidl_capsules.cc",
    "generated/nts_webidl_capsules.h",
    "nts_blink_dom.cc",
    "nts_blink_events.cc",
    "nts_blink_event_listener.cc",
    "nts_blink_event_listener.h",
    "nts_blink_node_registry.cc",
    "nts_blink_node_registry.h",
    "nts_blink_realm.cc",
    "nts_blink_realm.h",
    "nts_blink_subscription_registry.cc",
    "nts_blink_subscription_registry.h",
  ]

  include_dirs = [ "." ]

  configs += [
    "//third_party/blink/renderer:config",
    "//third_party/blink/renderer:non_test_config",
    "//third_party/blink/renderer:inside_blink",
    "//third_party/blink/renderer/core:blink_core_pch",
  ]

  deps = [
    ":nts_web_runtime",
    "//base",
    "//third_party/blink/renderer/core",
    "//third_party/blink/renderer/platform",
  ]
}

# The acceptance application remains plain C. It is the source shape ScriptC's
# C backend will eventually replace; no C++ rewrite is used for the Chromium
# harness.
source_set("nts_counter_example") {
  sources = [
    "counter/app.c",
    "counter/app.h",
  ]

  include_dirs = [ "." ]
  configs -= [
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]
  deps = [ ":nts_blink_bridge" ]
}

source_set("nts_create_element_example") {
  sources = [
    "create-element/app.c",
    "create-element/app.h",
  ]

  include_dirs = [ "." ]
  configs -= [
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]
  deps = [ ":nts_blink_bridge" ]
}

# Adapter from content's public WebLocalFrame seam into Blink's internal
# LocalFrame/Document world. Keeping this inside Blink avoids exposing core DOM
# implementation types to the content embedder.
source_set("nts_counter_host") {
  sources = [
    "nts_blink_benchmark_host.cc",
    "nts_blink_benchmark_host.h",
    "nts_blink_counter_host.cc",
    "nts_blink_counter_host.h",
  ]

  include_dirs = [ "." ]

  configs += [
    "//third_party/blink/renderer:config",
    "//third_party/blink/renderer:non_test_config",
    "//third_party/blink/renderer:inside_blink",
    "//third_party/blink/renderer/core:blink_core_pch",
  ]

  deps = [
    ":nts_blink_bridge",
    ":nts_counter_example",
    ":nts_create_element_example",
    "//base",
    "//third_party/blink/public:blink_headers",
    "//third_party/blink/renderer/core",
  ]

  # The TypeScript builder materializes both localized ScriptC archives before
  # GN generation. Their runtime definitions are private, so both backends can
  # coexist in this one matched content_shell binary.
  lib_dirs = [
    "$root_out_dir/gen/native_typescript/benchmark/c",
    "$root_out_dir/gen/native_typescript/benchmark/llvm",
  ]
  libs = [
    "scriptc-c",
    "scriptc-llvm",
  ]
}
