+class NativeTypeScriptCounterObserver final : public RenderFrameObserver {
+ public:
+  explicit NativeTypeScriptCounterObserver(RenderFrame* render_frame)
+      : RenderFrameObserver(render_frame) {}
+
+  NativeTypeScriptCounterObserver(const NativeTypeScriptCounterObserver&) =
+      delete;
+  NativeTypeScriptCounterObserver& operator=(
+      const NativeTypeScriptCounterObserver&) = delete;
+
+  void DidCreateNewDocument() override { Reset(); }
+
+  void DidDispatchDOMContentLoadedEvent() override {
+    Reset();
+    RenderFrame* frame = render_frame();
+    if (!frame || !frame->IsMainFrame())
+      return;
+    counter_host_ =
+        nts::blink_bridge::StartCounterHost(frame->GetWebFrame());
+  }
+
+  void OnDestruct() override {
+    Reset();
+    delete this;
+  }
+
+ private:
+  void Reset() {
+    if (!counter_host_)
+      return;
+    nts::blink_bridge::DestroyCounterHost(counter_host_);
+    counter_host_ = nullptr;
+  }
+
+  nts::blink_bridge::BlinkCounterHost* counter_host_ = nullptr;
+};
+
