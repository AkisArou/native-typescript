+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_EXCEPTION_STATE_CAPTURE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_EXCEPTION_STATE_CAPTURE_H_
+
+#define NTS_BLINK_HAS_EXCEPTION_STATE_CAPTURE 1
+
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+
+namespace blink {
+
+// Binding-neutral output storage for one scope-like ExceptionState. The
+// existing exception machinery writes into this object without constructing or
+// throwing a V8 value. Capture scopes may be nested on the same thread.
+class PLATFORM_EXPORT ExceptionStateCapture final {
+  STACK_ALLOCATED();
+
+ public:
+  ExceptionStateCapture();
+  ~ExceptionStateCapture();
+
+  ExceptionStateCapture(const ExceptionStateCapture&) = delete;
+  ExceptionStateCapture& operator=(const ExceptionStateCapture&) = delete;
+
+  ExceptionState& GetExceptionState() { return exception_state_; }
+  ExceptionCode Code() const { return code_; }
+  const String& SanitizedMessage() const { return sanitized_message_; }
+  const String& UnsanitizedMessage() const { return unsanitized_message_; }
+
+ private:
+  friend class ExceptionState;
+
+  static ExceptionStateCapture* For(ExceptionState& exception_state);
+  void SetExceptionInfo(ExceptionCode code,
+                        const String& sanitized_message,
+                        const String& unsanitized_message);
+
+  ExceptionState exception_state_;
+  ExceptionStateCapture* const previous_;
+  ExceptionCode code_ = 0;
+  String sanitized_message_;
+  String unsanitized_message_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_EXCEPTION_STATE_CAPTURE_H_
