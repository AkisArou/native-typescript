+#ifndef INCLUDE_V8_NATIVE_HEAP_CHECKPOINT_H_
+#define INCLUDE_V8_NATIVE_HEAP_CHECKPOINT_H_
+
+#include "cppgc/common.h"
+#include "v8config.h"
+
+namespace v8 {
+
+class Isolate;
+
+/**
+ * Performs a full unified garbage collection at an embedder-owned native
+ * allocation checkpoint. This is intended for long-running native work that
+ * allocates on the C++ heap without otherwise returning to V8's scheduler.
+ */
+V8_EXPORT bool CollectGarbageAtNativeAllocationCheckpoint(
+    Isolate* isolate, cppgc::EmbedderStackState stack_state);
+
+}  // namespace v8
+
+#endif  // INCLUDE_V8_NATIVE_HEAP_CHECKPOINT_H_
