 #include "include/v8-platform.h"
 #include "src/base/logging.h"
 #include "src/base/macros.h"
@@ -130,6 +131,19 @@ void CppHeap::CollectCustomSpaceStatisticsAtLastGC(
       std::move(custom_spaces), std::move(receiver));
 }
 
+bool CollectGarbageAtNativeAllocationCheckpoint(
+    Isolate* isolate, cppgc::EmbedderStackState stack_state) {
+  if (!isolate || isolate != Isolate::TryGetCurrent()) {
+    return false;
+  }
+  CppHeap* public_cpp_heap = isolate->GetCppHeap();
+  if (!public_cpp_heap) {
+    return false;
+  }
+  return internal::CppHeap::From(public_cpp_heap)
+      ->CollectGarbageAtNativeAllocationCheckpoint(stack_state);
+}
+
 void CppHeap::EnableDetachedGarbageCollectionsForTesting() {
   return internal::CppHeap::From(this)
       ->EnableDetachedGarbageCollectionsForTesting();
@@ -1311,6 +1325,19 @@ void CppHeap::CollectGarbage(cppgc::internal::GCConfig config) {
       !sweeper_.IsSweepingInProgress());
 }
 
+bool CppHeap::CollectGarbageAtNativeAllocationCheckpoint(
+    cppgc::EmbedderStackState stack_state) {
+  if (!IsGCAllowed()) {
+    return false;
+  }
+  EmbedderStackStateScope stack_scope(
+      isolate_->heap(), EmbedderStackStateOrigin::kExplicitInvocation,
+      stack_state);
+  isolate_->heap()->CollectAllGarbage(
+      GCFlag::kNoFlags, GarbageCollectionReason::kCppHeapAllocationFailure);
+  return true;
+}
