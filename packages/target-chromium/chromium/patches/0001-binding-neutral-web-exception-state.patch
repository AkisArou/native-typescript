+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_WEB_EXCEPTION_STATE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_WEB_EXCEPTION_STATE_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/platform/bindings/exception_code.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+// Binding-neutral representation of a Web-observable exception. This type
+// deliberately contains no v8::Isolate, v8::Value, ScriptState, or exception
+// propagation policy. Binding runtimes translate it into their own exception
+// representation after the DOM operation returns.
+class WebExceptionState final {
+  STACK_ALLOCATED();
+
+ public:
+  enum class Kind : uint8_t {
+    kNone,
+    kDOMException,
+    kSecurityError,
+    kRangeError,
+    kTypeError,
+    kSyntaxError,
+  };
+
+  WebExceptionState() = default;
+  WebExceptionState(const WebExceptionState&) = delete;
+  WebExceptionState& operator=(const WebExceptionState&) = delete;
+
+  void ThrowDOMException(DOMExceptionCode code, const String& message) {
+    if (HadException())
+      return;
+    kind_ = Kind::kDOMException;
+    dom_code_ = code;
+    message_ = message;
+  }
+
+  void ThrowSecurityError(const String& sanitized_message,
+                          const String& unsanitized_message = String()) {
+    if (HadException())
+      return;
+    kind_ = Kind::kSecurityError;
+    dom_code_ = DOMExceptionCode::kSecurityError;
+    message_ = sanitized_message;
+    unsanitized_message_ = unsanitized_message;
+  }
+
+  void ThrowRangeError(const String& message) {
+    SetError(Kind::kRangeError, message);
+  }
+
+  void ThrowTypeError(const String& message) {
+    SetError(Kind::kTypeError, message);
+  }
+
+  void ThrowSyntaxError(const String& message) {
+    SetError(Kind::kSyntaxError, message);
+  }
+
+  bool HadException() const { return kind_ != Kind::kNone; }
+  Kind GetKind() const { return kind_; }
+  DOMExceptionCode DOMCode() const { return dom_code_; }
+  const String& Message() const { return message_; }
+  const String& UnsanitizedMessage() const { return unsanitized_message_; }
+
+ private:
+  void SetError(Kind kind, const String& message) {
+    if (HadException())
+      return;
+    kind_ = kind;
+    message_ = message;
+  }
+
+  Kind kind_ = Kind::kNone;
+  DOMExceptionCode dom_code_ = DOMExceptionCode::kNoError;
+  String message_;
+  String unsanitized_message_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_WEB_EXCEPTION_STATE_H_
diff --git a/third_party/blink/renderer/platform/bindings/web_exception_to_v8.h b/third_party/blink/renderer/platform/bindings/web_exception_to_v8.h
